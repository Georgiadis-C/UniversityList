<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:UniversityList.ViewModels"
             x:DataType="local:AddUpdateStudentDetailViewModel"
             x:Class="UniversityList.Views.AddUpdateStudentDetail"
             Title="Student Details"
             BackgroundColor="#0B0E11">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Label" x:Key="FieldLabelStyle">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="TextColor" Value="#8A8D91"/>
                <Setter Property="Margin" Value="5,0"/>
                <Setter Property="FontAttributes" Value="Bold"/>
            </Style>

            <Style TargetType="Label" x:Key="ErrorLabelStyle">
                <Setter Property="TextColor" Value="#FF5252"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="10,2,0,0"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Margin="20" Spacing="18">
            
            <Label Text="Add / Update Student" 
                   FontSize="24" 
                   TextColor="White" 
                   FontAttributes="Bold" 
                   Margin="0,0,0,10"/>

            <VerticalStackLayout>
                <Label Text="FIRST NAME" Style="{StaticResource FieldLabelStyle}" />
                <Border Stroke="#1A1D21" StrokeThickness="2" BackgroundColor="#1A1D21" Padding="5">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Entry Text="{Binding StudentDetail.FirstName}" Placeholder="e.g. John" TextColor="White" PlaceholderColor="#4A4D51" />
                </Border>
                <Label Text="{Binding FirstNameError}" Style="{StaticResource ErrorLabelStyle}" 
                       IsVisible="{Binding FirstNameError, Converter={StaticResource StringNotEmptyToBoolConverter}}"/>
            </VerticalStackLayout>

            <VerticalStackLayout>
                <Label Text="LAST NAME" Style="{StaticResource FieldLabelStyle}" />
                <Border Stroke="#1A1D21" StrokeThickness="2" BackgroundColor="#1A1D21" Padding="5">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Entry Text="{Binding StudentDetail.LastName}" Placeholder="e.g. Doe" TextColor="White" PlaceholderColor="#4A4D51" />
                </Border>
                <Label Text="{Binding LastNameError}" Style="{StaticResource ErrorLabelStyle}" 
                       IsVisible="{Binding LastNameError, Converter={StaticResource StringNotEmptyToBoolConverter}}"/>
            </VerticalStackLayout>

            <VerticalStackLayout>
                <Label Text="EMAIL" Style="{StaticResource FieldLabelStyle}" />
                <Border Stroke="#1A1D21" StrokeThickness="2" BackgroundColor="#1A1D21" Padding="5">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Entry Text="{Binding StudentDetail.Email}" Keyboard="Email" Placeholder="example@gmail.com" TextColor="White" PlaceholderColor="#4A4D51" />
                </Border>
                <Label Text="{Binding EmailError}" Style="{StaticResource ErrorLabelStyle}" 
                       IsVisible="{Binding EmailError, Converter={StaticResource StringNotEmptyToBoolConverter}}"/>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="YEAR" Style="{StaticResource FieldLabelStyle}" />
                    <Border Stroke="#1A1D21" StrokeThickness="2" BackgroundColor="#1A1D21" Padding="5">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Entry Text="{Binding StudentDetail.YearAdded}" Keyboard="Numeric" Placeholder="2024" TextColor="White" />
                    </Border>
                    <Label Text="{Binding YearAddedError}" Style="{StaticResource ErrorLabelStyle}" 
                           IsVisible="{Binding YearAddedError, Converter={StaticResource StringNotEmptyToBoolConverter}}"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1">
                    <Label Text="GPA" Style="{StaticResource FieldLabelStyle}" />
                    <Border Stroke="#1A1D21" StrokeThickness="2" BackgroundColor="#1A1D21" Padding="5">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Entry Text="{Binding StudentDetail.GPA}" Keyboard="Numeric" Placeholder="8.5" TextColor="White" />
                    </Border>
                    <Label Text="{Binding GpaError}" Style="{StaticResource ErrorLabelStyle}" 
                           IsVisible="{Binding GpaError, Converter={StaticResource StringNotEmptyToBoolConverter}}"/>
                </VerticalStackLayout>
            </Grid>

            <Button Text="SAVE DETAILS" 
                    Command="{Binding AddUpdateStudentCommand}"
                    BackgroundColor="#2A2D31"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="55"
                    FontAttributes="Bold"
                    Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>